<% if (typeof showCartFab !== 'undefined' && showCartFab) { %>
  <a class="cart-fab" href="/cart" aria-label="View cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 4h2l2.6 10.4a2 2 0 0 0 2 1.6h7.2a2 2 0 0 0 2-1.5L21 7H6" />
      <circle cx="10" cy="20" r="1.4" />
      <circle cx="18" cy="20" r="1.4" />
    </svg>
    <% if (fabCartCount > 0) { %><span class="cart-fab-count"><%= fabCartCount %></span><% } %>
  </a>
<% } %>

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Pick Slip — Order #<%= order.id %></title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <style>
    body { font-family: Arial, sans-serif; padding: 30px; color: #111; }
    h1 { font-size: 1.4rem; border-bottom: 2px solid #111; padding-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { border: 1px solid #999; padding: 8px; text-align: left; font-size: 0.95rem; }
    th { background: #eee; }
    .meta { margin: 10px 0; }
    .meta span { display:inline-block; margin-right: 30px; }
    .sign { margin-top: 50px; display:flex; gap: 60px; }
    .sign div { border-top: 1px solid #333; width: 200px; padding-top: 6px; font-size: 0.85rem; }
    .slip-logo { height: 54px; width: auto; display: block; margin-bottom: 10px; }
  </style>
</head>
<body onload="window.print()">
  <img class="slip-logo" src="/img/logo.png" alt="Techno Automotives Limited" />
  <h1>Techno Automotives — Pick Slip</h1>
  <div class="meta">
    <span><strong>Order #:</strong> <%= order.id %></span>
    <span><strong>Business:</strong> <%= order.business_name %></span>
    <span><strong>Date:</strong> <%= new Date(order.created_at).toLocaleString() %></span>
  </div>
  <table>
    <thead>
      <tr><th>Part #</th><th>Name</th><th>Qty</th><th>Unit Price</th><th>Line Total</th></tr>
    </thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.part_number_snapshot %></td>
          <td><%= i.name_snapshot %></td>
          <td><%= i.quantity %></td>
          <td>KES <%= i.unit_price.toLocaleString() %></td>
          <td>KES <%= i.line_total.toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p style="text-align:right; font-size:1.1rem; margin-top:14px;"><strong>Total: KES <%= order.total_amount.toLocaleString() %></strong></p>

  <div class="sign">
    <div>Checked by</div>
    <div>Dispatched by</div>
  </div>
</body>
</html>

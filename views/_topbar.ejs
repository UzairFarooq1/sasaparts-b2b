<div class="topbar">
  <a class="brand" href="/"><img class="brand-logo" src="/img/logo.png" alt="Techno Automotives Limited" /></a>
  <nav>
    <% if (user.role === 'admin') { %>
      <a href="/admin/orders" class="<%= navActive('/admin/orders') %>">Orders</a>
      <a href="/admin/businesses" class="<%= navActive('/admin/businesses') %>">Customers &amp; Credit</a>
      <a href="/admin/parts" class="<%= navActive('/admin/parts') %>">Parts &amp; Stock</a>
    <% } else { %>
      <a href="/catalog" class="<%= navActive('/catalog') %>">Search Parts</a>
      <a href="/cart" class="<%= navActive('/cart') %>">Cart</a>
      <a href="/orders" class="<%= navActive('/orders') %>">My Orders</a>
    <% } %>
  </nav>
  <div class="right">
    <span style="color:var(--muted); font-size:0.9rem;"><%= user.business_name %> (<%= user.username %>)</span>
    <form method="POST" action="/logout" style="margin:0;">
      <button type="submit" class="btn-secondary">Logout</button>
    </form>
  </div>
</div>
